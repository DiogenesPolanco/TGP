# .secretsignore - known false positives for secret scanning
#
# Format:
#   file-pattern-regex:line-content-regex
#   bare-content-regex          (matches line content anywhere)
#
# Lines starting with # are ignored.

# HTML input types are not secrets
type="password"
type='password'

# JWT documentation text in seed data
seedData\.ts:.*JWT.*

# API configuration type definitions (not actual values)
types\.ts:apiKey
types\.ts:password

# Test data / mocks (not real secrets)
__tests__/remote-backend\.test\.ts:password
__tests__/automatedChecksService\.test\.ts:secret-key
__tests__/encryptionService\.test\.ts:secret
__tests__/fieldCipher\.test\.ts:secret data

# TOTP secret handling in auth (legitimate crypto, not credential leak)
LoginPage\.tsx:secret\.base32
LoginPage\.tsx:secret\.uri

# Base64 range end warnings from grep (false positive in grep itself)
Invalid range end
