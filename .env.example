# ── TGP Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# TGP is a client-side SPA — most features work offline
# with zero configuration. These vars are OPTIONAL and only
# needed for cloud integrations.

# ── Azure Blob Storage (Backups & Public Sharing) ────────────
# SAS URL with read/write/list permissions to a blob container.
# Configured via the app UI, but can also be set here.
# AZURE_SAS_URL=

# ── PostgreSQL / PGlite (Desktop app only) ───────────────────
# PGP_PROXY_PORT=9876

# ── Jira Integration ─────────────────────────────────────────
# Jira credentials are configured through the app UI.
# No env vars needed.

# ── Development Server ───────────────────────────────────────
# VITE_DEV_SERVER_URL=http://localhost:5173
