{
  "name": "tgp",
  "private": true,
  "version": "1.1.10",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "DiogenesPolanco <diogenespolancomartinez@gmail.com>",
  "description": "TGP - Technology Governance Platform",
  "desktopName": "TGP",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-version.cjs && tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "preview": "vite preview",
    "desktop": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "desktop:build": "npm run build && PGP_PROXY_PORT=9876 electron .",
    "build:desktop:linux": "npm run build && electron-builder --linux --x64",
    "build:desktop:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "build:desktop:win": "npm run build && electron-builder --win --x64",
    "build:desktop:all": "npm run build && electron-builder --linux --x64 --win --x64 --mac --x64 --arm64",
    "build:desktop": "npm run build && electron-builder --$(uname -s | tr '[:upper:]' '[:lower:]') --x64",
    "desktop:release": "standard-version && git push --follow-tags origin master",
    "version:bump": "standard-version",
    "version:bump:dry": "standard-version --dry-run",
    "version:current": "node -p \"require('./package.json').version\"",
    "security:scan": "bash scripts/detect-secrets.sh --all",
    "security:audit": "npm audit --audit-level=high",
    "security:all": "npm run security:scan && npm run lint && npm run security:audit",
    "quality:all": "npm run format:check && npm run security:scan && npm run lint && npx tsc --noEmit && npm run test:coverage && npm audit --audit-level=high",
    "quality:gate": "bash scripts/quality-gate.sh"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@azure/storage-blob": "^12.31.0",
    "@electric-sql/pglite": "^0.5.4",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.0",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-code-block-lowlight": "^3.26.0",
    "@tiptap/extension-image": "^3.26.0",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/extension-table": "^3.26.0",
    "@tiptap/extension-table-cell": "^3.26.0",
    "@tiptap/extension-table-header": "^3.26.0",
    "@tiptap/extension-table-row": "^3.26.0",
    "@tiptap/extension-text-align": "^3.26.0",
    "@tiptap/extension-underline": "^3.26.0",
    "@tiptap/markdown": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "apexcharts": "^5.13.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^12.40.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.17.0",
    "otpauth": "^9.5.1",
    "papaparse": "^5.5.3",
    "pg": "^8.22.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-apexcharts": "^2.1.0",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.77.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "ws": "^8.21.1",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@omniroute/opencode-provider": "^0.1.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-security": "^4.0.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.tgp.app",
    "productName": "TGP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/ws/**/*",
      "node_modules/pg/**/*",
      "node_modules/pg-pool/**/*",
      "node_modules/pg-protocol/**/*",
      "node_modules/pg-types/**/*",
      "node_modules/pgpass/**/*",
      "node_modules/semver/**/*",
      "node_modules/split2/**/*",
      "node_modules/postgres-bytea/**/*",
      "node_modules/postgres-date/**/*",
      "node_modules/postgres-interval/**/*",
      "node_modules/postgres-range/**/*",
      "node_modules/packet-reader/**/*",
      "node_modules/xtend/**/*",
      "node_modules/obuf/**/*",
      "node_modules/buffer-writer/**/*",
      "node_modules/pg-connection-string/**/*",
      "node_modules/pg-int8/**/*",
      "node_modules/pg-numeric/**/*",
      "node_modules/pg-cloudflare/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "public/icons/icon-512x512.png",
      "maintainer": "DiogenesPolanco <diogenespolancomartinez@gmail.com>"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icons/icon-512x512.png",
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icons/icon.ico",
      "artifactName": "TGP.Setup.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icons/icon.ico"
    }
  }
}
